            </div>    <script type="text/javascript">
                require(['jquery'], function ($) {
                    $(document).ready(function () {
                        const FrontendTutorial = {
                            // ========== CONSTANTS ==========
                            STORAGE_KEYS: {
                                SKIPPED: 'frontendTutorialSkipped',
                                CURRENT_STEP: 'frontendTutorialStep',
                                FLOW_TYPE: 'tutorialFlow'
                            },

                            SELECTORS: {
                                SECTIONS_NAV: '.sections.nav-sections',
                                SEARCH_BLOCK: '.block.block-search',
                                TUTORIAL_OVERLAY: '#tutorial-overlay',
                                POPUP_CONTAINER: '#popup-container',
                                FIRST_BOX: '#tutorial-first-box',
                                END_BOX: '#tutorial-end-box',
                                PAYPAL_BUTTON: 'div#paypal-smart-button'
                            },

                            CSS_CLASSES: {
                                HIGHLIGHT: 'tutorial-highlight',
                                TOOLTIP: 'tutorial-tooltip'
                            },

                            // ========== STATE VARIABLES ==========
                            multiFlow: <?= json_encode($hasRegistered && $hasUnregistered) ?>,
                            allSteps: {
                                registered: <?= json_encode(array_values(array_map(function ($s) {
                                    return [
                                        'title' => $s['module_name'],
                                        'content' => $s['content'],
                                        'element' => $s['element'],
                                        'url' => $s['page'],
                                        'trigger' => $s['trigger'],
                                        'position' => $s['notice_position'] ?? 'bottom'
                                    ];
                                }, $stepsRegister))); ?>,
                                unregistered: <?= json_encode(array_values(array_map(function ($s) {
                                    return [
                                        'title' => $s['module_name'],
                                        'content' => $s['content'],
                                        'element' => $s['element'],
                                        'url' => $s['page'],
                                        'trigger' => $s['trigger'],
                                        'position' => $s['notice_position'] ?? 'bottom'
                                    ];
                                }, $stepsUnregister))); ?>
                            },

                            steps: [],
                            currentStep: -1,
                            type: 'unregistered',

                            // ========== INITIALIZATION ==========
                            init: function() {
                                if (this.isSkipped()) return;
                                this.setupInitialStyles();
                                this.resumeOrStartTutorial();
                                this.bindEvents();
                            },

                            isSkipped: function() {
                                return localStorage.getItem(this.STORAGE_KEYS.SKIPPED) === 'true';
                            },

                            setupInitialStyles: function() {
                                $(this.SELECTORS.SECTIONS_NAV).css('z-index', '1');
                                $(this.SELECTORS.SEARCH_BLOCK).css('z-index', '1');
                            },

                            // ========== TUTORIAL FLOW CONTROL ==========

                            resumeOrStartTutorial: function() {
                                const savedStep = localStorage.getItem(this.STORAGE_KEYS.CURRENT_STEP);

                                if (savedStep !== null) {
                                    this.resumeTutorial(parseInt(savedStep, 10));
                                } else {
                                    this.showFirstPopup();
                                }
                            },

                            resumeTutorial: function(savedStep) {
                                this.currentStep = savedStep;
                                this.type = this.multiFlow ?
                                    localStorage.getItem(this.STORAGE_KEYS.FLOW_TYPE) || 'unregistered' :
                                    'unregistered';
                                this.steps = this.allSteps[this.type] || [];

                                $(this.SELECTORS.TUTORIAL_OVERLAY + ',' + this.SELECTORS.POPUP_CONTAINER).show();
                                this.showStep(this.currentStep);
                            },

                            showFirstPopup: function() {
                                if (this.isSkipped()) return;
                                $(this.SELECTORS.TUTORIAL_OVERLAY + ',' +
                                    this.SELECTORS.POPUP_CONTAINER + ',' +
                                    this.SELECTORS.FIRST_BOX).fadeIn();
                            },

                            closeTutorial: function() {
                                localStorage.setItem(this.STORAGE_KEYS.SKIPPED, 'true');
                                $(this.SELECTORS.POPUP_CONTAINER + ',' + this.SELECTORS.TUTORIAL_OVERLAY).fadeOut();
                                $('.' + this.CSS_CLASSES.HIGHLIGHT).removeClass(this.CSS_CLASSES.HIGHLIGHT);
                                $('.' + this.CSS_CLASSES.TOOLTIP).remove();
                            },

                            // ========== STEP MANAGEMENT ==========
                            showStep: function(idx) {
                                if (idx < 0 || idx >= this.steps.length) return;

                                const step = this.steps[idx];

                                if (!this.isCorrectUrl(step.url)) {
                                    this.navigateToStep(idx, step.url);
                                    return;
                                }

                                this.handleTrigger(step);
                                this.styleARPBlockOnOsc();
                                this.prepareStepUI(step);

                                const $target = $(step.element);
                                this.highlightTarget($target);
                                this.observeDomChanges($target);

                                const $tooltip = this.renderTooltip(step, idx);
                                this.positionTooltip($tooltip, $target, step);

                                this.bindTooltipEvents($tooltip);
                                this.addProductToCart();

                                $(this.SELECTORS.PAYPAL_BUTTON).css({'position': 'relative', 'z-index': '99'});
                            },

                            isCorrectUrl: function(stepUrl) {
                                return window.location.pathname + window.location.search === stepUrl;
                            },

                            navigateToStep: function(stepIndex, url) {
                                localStorage.setItem(this.STORAGE_KEYS.CURRENT_STEP, stepIndex);
                                window.location.href = url;
                            },

                            prepareStepUI: function(step) {
                                $('.' + this.CSS_CLASSES.HIGHLIGHT).removeClass(this.CSS_CLASSES.HIGHLIGHT);
                                $('.' + this.CSS_CLASSES.TOOLTIP).remove();
                            },

                            highlightTarget: function($target) {
                                const self = this;

                                if ($target.length && self.currentStep !== 4) {
                                    $target.addClass(this.CSS_CLASSES.HIGHLIGHT);
                                    this.animateBody($target);
                                } else {
                                    this.waitForPageStable(function() {
                                        const $retarget = $(self.steps[self.currentStep].element);
                                        if ($retarget.length) {
                                            $retarget.addClass(self.CSS_CLASSES.HIGHLIGHT);
                                            self.animateBody($retarget);
                                        }
                                    });
                                }

                                if ($target.find('.tutorial-overlay').length) {
                                    $('.tutorial-overlay').insertAfter($target);
                                }
                            },

                            // ========== TOOLTIP MANAGEMENT ==========
                            renderTooltip: function(step, index) {
                                const $tooltip = $('<div class="' + this.CSS_CLASSES.TOOLTIP + '"></div>');

                                const tooltipHTML = `
                    <div class="content-title">${step.title}</div>
                    <div class="step-content">${step.content}</div>
                    <div class="tutorial-toolbar">
                        <button class="skip-tutorial">Skip</button>
                        <span id="step-counter">${index + 1} of ${this.steps.length}</span>
                        <div>
                            <button id="prev-step" ${index === 0 ? 'style="display:none;"' : ''}>Back</button>
                            <button id="next-step" ${index === this.steps.length ? 'style="display:none;"' : ''}>Next</button>
                        </div>
                    </div>
                `;

                                $tooltip.html(tooltipHTML);
                                $('body').append($tooltip);

                                return $tooltip;
                            },

                            positionTooltip: function($tooltip, $target, step) {
                                if ($target.length) {
                                    $tooltip.addClass(step.position || 'bottom');
                                    this.calculateTooltipPosition($target.offset(), step.position || 'bottom', $tooltip, $target);
                                } else {
                                    this.positionTooltipCenter($tooltip, step);
                                }
                            },

                            positionTooltipCenter: function($tooltip, step) {
                                if (step.position === 'top') {
                                    $tooltip.css({
                                        top: $(window).scrollTop() + 20,
                                        left: ($(window).width() - $tooltip.outerWidth()) / 2
                                    });
                                    $tooltip.addClass('bottom');
                                } else {
                                    $tooltip.css({
                                        top: $(window).scrollTop() + ($(window).height() - $tooltip.outerHeight()) / 2,
                                        left: ($(window).width() - $tooltip.outerWidth()) / 2
                                    });
                                }
                            },

                            calculateTooltipPosition: function(offset, position, $tooltip, $target) {
                                let posBonus = 30;

                                switch (position) {
                                    case 'top':
                                        if (this.currentStep === 0) posBonus = 30;
                                        $tooltip.css({
                                            top: offset.top - $tooltip.outerHeight() - posBonus,
                                            left: offset.left
                                        });
                                        break;

                                    case 'right':
                                        if (this.currentStep === 1) posBonus = 240;
                                        $tooltip.css({
                                            top: offset.top + $target.outerHeight() / 2 - $tooltip.outerHeight() / 2 - posBonus,
                                            left: offset.left + $target.outerWidth() + 15
                                        });
                                        break;

                                    case 'left':
                                        $tooltip.css({
                                            top: offset.top + $target.outerHeight() / 2 - $tooltip.outerHeight() / 2,
                                            left: offset.left - $tooltip.outerWidth() - 30
                                        });
                                        break;

                                    default: // bottom
                                        $tooltip.css({
                                            top: offset.top + $target.outerHeight() + 30,
                                            left: offset.left
                                        });
                                }
                            },

                            // ========== EVENT HANDLERS ==========
                            bindEvents: function() {
                                const self = this;

                                // Multi-flow buttons
                                $('.start-flow').on('click', function() {
                                    self.startFlow($(this).data('type'));
                                });

                                // Single flow button
                                $('#start-tutorial').on('click', function() {
                                    self.startSingleFlow();
                                });

                                // Previous step trong end box
                                $('#prev-last-step').on('click', function() {
                                    self.goToPreviousFromEnd();
                                });

                                // Skip tutorial buttons
                                $('.skip-tutorial').on('click', function() {
                                    self.closeTutorial();
                                });

                                // Window events
                                $(window).on('resize scroll', function() {
                                    self.updateTooltipPosition();
                                });
                            },

                            bindTooltipEvents: function($tooltip) {
                                const self = this;

                                // Next step button
                                $('#next-step').off('click').on('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    self.goToNextStep();
                                });

                                // Previous step button
                                $('#prev-step').off('click').on('click', function(e) {
                                    e.preventDefault();
                                    e.stopPropagation();
                                    self.goToPreviousStep();
                                });

                                // Skip button
                                $('.skip-tutorial').off('click').on('click', function() {
                                    self.closeTutorial();
                                });
                            },

                            addProductToCart: function() {
                                const self = this;

                                if (self.currentStep !== 2) return;
                                const formKey = $('[name="form_key"]').val();

                                let productData = {
                                    product: 1348,
                                    selected_configurable_option: '',
                                    related_product: '',
                                    item: 1348,
                                    form_key: formKey,
                                    'super_attribute[144]': 167,
                                    'super_attribute[93]': 49,
                                    qty: 1
                                };

                                $.ajax({
                                    url: '/checkout/cart/add/',
                                    type: 'POST',
                                    data: productData,

                                    success: function(response) {
                                        console.log('Product added to cart successfully');
                                    },
                                    error: function() {
                                        console.warn('Failed to add product to cart');
                                    }
                                });
                            },
                            observeDomChanges: function($target) {
                                const self = this;
                                const targetNode = document.body;
                                const config = { childList: true, subtree: true };

                                if (self.currentStep !== 4) return;

                                let debounceTimer;
                                const observer = new MutationObserver(() => {
                                    self.updateTooltipPosition();

                                    if ($target.length) {
                                        clearTimeout(debounceTimer);
                                        debounceTimer = setTimeout(() => {
                                            self.waitForPageStable(function() {
                                                if ($target.length && !self.isInViewport($target)) {
                                                    self.animateBody($target);
                                                }
                                            });
                                        }, 300);
                                    }
                                });

                                observer.observe(targetNode, config);
                                this.domObserver = observer;
                            },

                            // ========== NAVIGATION METHODS ==========
                            goToNextStep: function() {
                                this.handleTrigger(this.steps[this.currentStep]);

                                if (this.currentStep < this.steps.length - 1) {
                                    this.currentStep++;
                                    this.showStep(this.currentStep);
                                } else {
                                    this.finishTutorial();
                                }
                            },

                            goToPreviousStep: function() {
                                this.handleTrigger(this.steps[this.currentStep]);

                                if (this.currentStep > 0) {
                                    this.currentStep--;
                                    this.showStep(this.currentStep);
                                }
                            },

                            goToPreviousFromEnd: function() {
                                this.currentStep = this.steps.length - 1;
                                $(this.SELECTORS.END_BOX).fadeOut(() => {
                                    this.showStep(this.currentStep);
                                });
                            },

                            finishTutorial: function() {
                                $('.' + this.CSS_CLASSES.TOOLTIP).remove();
                                $('.' + this.CSS_CLASSES.HIGHLIGHT).removeClass(this.CSS_CLASSES.HIGHLIGHT);
                                $(this.SELECTORS.END_BOX).fadeIn();
                                $(this.SELECTORS.TUTORIAL_OVERLAY).insertAfter(this.SELECTORS.POPUP_CONTAINER);
                            },

                            // ========== FLOW MANAGEMENT ==========
                            startFlow: function(type) {
                                this.type = type;
                                this.steps = this.allSteps[type] || [];
                                this.currentStep = 0;
                                localStorage.setItem(this.STORAGE_KEYS.CURRENT_STEP, this.currentStep);
                                localStorage.setItem(this.STORAGE_KEYS.FLOW_TYPE, type);

                                if (type === 'registered') {
                                    this.handleDemoAutoLogin();
                                } else {
                                    this.startTutorialFlow();
                                }
                            },

                            startSingleFlow: function() {
                                this.type = 'unregistered';
                                this.steps = this.allSteps[this.type] || [];
                                this.currentStep = 0;
                                localStorage.setItem(this.STORAGE_KEYS.CURRENT_STEP, this.currentStep);
                                this.startTutorialFlow();
                            },

                            startTutorialFlow: function() {
                                $(this.SELECTORS.FIRST_BOX).fadeOut(() => {
                                    this.showStep(this.currentStep);
                                });
                            },

                            // ========== HELPER METHODS ==========
                            handleTrigger: function(step) {
                                if (step.trigger && step.trigger !== 'none') {
                                    const $trigger = $(step.trigger);
                                    if ($trigger.length) {
                                        $trigger.trigger('click');
                                    }
                                }
                            },

                            handleDemoAutoLogin: function() {
                                const self = this;
                                const formKey = $('.form-customer-login [name="form_key"]').val();

                                $.ajax({
                                    url: window.location.origin + '/customer/ajax/login',
                                    type: 'POST',
                                    data: JSON.stringify({
                                        username: 'roni_cost@example.com',
                                        password: 'roni_cost3@example.com',
                                        form_key: formKey
                                    }),
                                    success: function(resp) {
                                        self.startTutorialFlow();
                                    },
                                    error: function() {
                                        alert('Login failed.');
                                    }
                                });
                            },

                            waitForPageStable: function(callback, timeout = 4000) {
                                let lastHeight = 0;
                                let stableCount = 0;
                                const requiredStableCount = 10;
                                const start = Date.now();

                                $('body').trigger('processStart');

                                const checkStability = setInterval(() => {
                                    const currentHeight = document.body.scrollHeight;

                                    if (currentHeight === lastHeight) {
                                        stableCount++;
                                    } else {
                                        stableCount = 0;
                                        lastHeight = currentHeight;
                                    }

                                    if (stableCount >= requiredStableCount) {
                                        clearInterval(checkStability);
                                        $('body').trigger('processStop');
                                        setTimeout(callback, 200);
                                    } else if (Date.now() - start > timeout) {
                                        clearInterval(checkStability);
                                        $('body').trigger('processStop');
                                        console.warn('Page stability timeout, proceeding anyway');
                                        callback();
                                    }
                                }, 100);
                            },

                            updateTooltipPosition: function() {
                                const $tooltip = $('.' + this.CSS_CLASSES.TOOLTIP);
                                const $target = $('.' + this.CSS_CLASSES.HIGHLIGHT);

                                if ($target.length && $target.is(':visible') && $tooltip.length) {
                                    const step = this.steps[this.currentStep];
                                    if (step) {
                                        this.calculateTooltipPosition($target.offset(), step.position || 'bottom', $tooltip, $target);
                                    }
                                }
                            },

                            animateBody: function($target) {
                                const self = this;
                                var posBonus = 0;

                                if (self.currentStep === 0) {
                                    posBonus = 350;
                                }

                                if (self.currentStep === 1) {
                                    posBonus = 800;
                                }
                                $('html,body').animate({
                                    scrollTop: $target.offset().top - 150 - posBonus}, 500
                                );
                            },

                            styleARPBlockOnOsc: function() {
                                if (this.currentStep !== 4) return;

                                $('.mageplaza-autorelated-content').css('float', 'right');
                            },

                            isInViewport: function($el) {
                                const el = $el[0];
                                const rect = el.getBoundingClientRect();
                                return (
                                    rect.top >= 0 &&
                                    rect.left >= 0 &&
                                    rect.bottom <= (window.innerHeight || document.documentElement.clientHeight) &&
                                    rect.right <= (window.innerWidth || document.documentElement.clientWidth)
                                );
                            }
                        };

                        // ========== INITIALIZE TUTORIAL ==========
                        FrontendTutorial.init();
                    });
                });
            </script>
        </div>
    </div>



