    </div>
    <script type="text/javascript">
        require(['jquery', 'select20dom'], function ($) {
            $(window).on('load', function () {
                // ==================== CONSTANTS & VARIABLES ====================

                // Tutorial steps data from PHP
                let steps = <?php echo json_encode(array_values(array_map(function ($step) {
                    return [
                        'title'    => $step['module_name'],
                        'content'  => $step['content'],
                        'element'  => $step['element'],
                        'url'      => $step['page'],
                        'trigger'  => $step['trigger'],
                        'position' => $step['notice_position'] ?? 'bottom'
                    ];
                }, $steps))); ?>;

                let currentStep = -1;
                const STORAGE_KEYS = {
                    TUTORIAL_SKIPPED: 'tutorialSkipped',
                    TUTORIAL_STEP: 'tutorialStep'
                };

                // ==================== HANDLE LOCALSTORAGE FUNCTIONS ====================

                /**
                 * Check if tutorial was previously skipped
                 * @returns {boolean}
                 */
                function isSkipped() {
                    return localStorage.getItem(STORAGE_KEYS.TUTORIAL_SKIPPED) === 'true';
                }

                /**
                 * Mark tutorial as skipped in localStorage
                 */
                function markTutorialAsSkipped() {
                    localStorage.setItem(STORAGE_KEYS.TUTORIAL_SKIPPED, 'true');
                }

                /**
                 * Save the current step index to localStorage
                 * @param {number} stepIndex
                 */
                function saveCurrentStep(stepIndex) {
                    localStorage.setItem(STORAGE_KEYS.TUTORIAL_STEP, stepIndex);
                }

                /**
                 * Get saved step from localStorage
                 * @returns {number|null}
                 */
                function getSavedStep() {
                    const saved = localStorage.getItem(STORAGE_KEYS.TUTORIAL_STEP);
                    return saved !== null ? parseInt(saved) : null;
                }

                function isInViewport($el) {
                    const rect = $el[0].getBoundingClientRect();
                    return rect.top >= 0 && rect.left >= 0 &&
                        rect.bottom <= window.innerHeight && rect.right <= window.innerWidth;
                }

                // ==================== DOM MANIPULATION FUNCTIONS ====================

                /**
                 * Clean up tutorial UI elements
                 */
                function cleanupTutorialUI() {
                    $('.tutorial-highlight').removeClass('tutorial-highlight');
                    $('.tutorial-tooltip, .tutorial-tooltip-left').remove();
                    // Remove dynamic styles
                    $('head style').filter(function() {
                        return $(this).text().includes('.tutorial-tooltip::before');
                    }).remove();
                }

                /**
                 * Skip the tutorial and hide all UI elements
                 */
                function skipTutorial() {
                    $('#popup-container, #tutorial-overlay').fadeOut();
                }

                /**
                 * Show the initial tutorial popup
                 */
                function showFirstPopup() {
                    if (isSkipped()) return;
                    $('#tutorial-overlay, #popup-container, #tutorial-first-box').fadeIn();
                }

                /**
                 * Create and return tooltip HTML content
                 * @param {Object} step - Current step data
                 * @param {number} index - Current step index
                 * @returns {string} HTML content for tooltip
                 */
                function createTooltipContent(step, index) {
                    return `
                <div class="content-title">${step.title}</div>
                <div class="step-content">${step.content}</div>
                <div class="tutorial-toolbar">
                    <button class="skip-tutorial">Skip</button>
                    <span id="step-counter">${index + 1} of ${steps.length}</span>
                    <div>
                        <button id="prev-step" ${index === 0 ? 'style="display:none;"' : ''}>Back</button>
                        <button id="next-step" ${index === steps.length ? 'style="display:none;"' : ''}>Next</button>
                    </div>
                </div>
            `;
                }

                function addStyleToHead(css) {
                    $(css).appendTo('head');
                }

                function removeStyleOnHead(id){
                    const element = $(id);
                    if (element.length) {
                        element.remove();
                    }
                }

                function moveTemplateNote() {
                    var $note = $("#default_template-note"),

                        $control = $note.closest(".admin__field-control");
                    $note.addClass('default_template-note-edit');
                    $note.insertAfter($control);
                }

                function resetTemplateNote() {
                    var $note = $("#default_template-note"),
                        $control = $note.siblings(".admin__field-control");

                    if ($note.length && $control.length) {
                        $control.append($note);
                        $note.removeClass('default_template-note-edit');
                    }
                }

                function changeSelect2Css() {
                    var $select2 = $('#base_fieldset .field-default_template .admin__field-control');
                    if ($select2.length) {
                        $select2.addClass('select2-edit');
                    }
                }

                function resetSelect2Css () {
                    var $select2 = $('#base_fieldset .field-default_template .admin__field-control');
                    if ($select2.length) {
                        $select2.removeClass('select2-edit');
                    }
                }
                // ==================== POSITIONING FUNCTIONS ====================

                /**
                 * Position tooltip relative to target element
                 * @param {Object} offset - Target element offset
                 * @param {string} position - Position type (top, right, left, bottom)
                 * @param {jQuery} $tooltip - Tooltip element
                 * @param {jQuery} $target - Target element
                 */
                function tooltipPositioning(offset, position, $tooltip, $target) {
                    const tooltipHeight = $tooltip.outerHeight(),
                          tooltipWidth  = $tooltip.outerWidth(),
                          targetHeight  = $target.outerHeight(),
                          targetWidth   = $target.outerWidth();
                    let top  = 0,
                        left = 0;

                    switch (position) {
                        case 'top':
                            if (currentStep === 9) {
                                left = 800;
                            }
                            $tooltip.css({
                                top: offset.top - tooltipHeight - 15,
                                left: offset.left + left,
                                position: 'absolute'
                            });
                            break;

                        case 'right':
                            $tooltip.css({
                                top: offset.top + targetHeight / 2 - tooltipHeight / 2 + top,
                                left: offset.left + targetWidth + 30,
                                position: 'absolute'
                            });
                            break;

                        case 'left':
                            if (currentStep === 12) {
                                left = 210;
                            }

                            $tooltip.css({
                                top: offset.top + targetHeight / 2 - tooltipHeight / 2,
                                left: offset.left - 10 - targetWidth / 2 - tooltipWidth / 2 + left,
                                position: 'absolute'
                            });
                            break;

                        case 'bottom':
                        default:
                            $tooltip.css({
                                top: offset.top + targetHeight + 30,
                                left: offset.left,
                                position: 'absolute'
                            });
                            break;
                    }
                }

                /**
                 * Center tooltip on screen when target element is not available
                 * @param {jQuery} $tooltip - Tooltip element
                 */
                function centerTooltipOnScreen($tooltip) {
                    $tooltip.css({
                        top: $(window).scrollTop() + ($(window).height() - $tooltip.outerHeight()) / 2,
                        left: ($(window).width() - $tooltip.outerWidth()) / 2,
                        position: 'absolute'
                    });
                    // Hide tooltip arrow when centered
                    addStyleToHead('<style>.tutorial-tooltip::before { display: none !important; content: none !important; }</style>');
                }

                /**
                 * Update tooltip position on window resize/scroll
                 */
                function updateTooltipPosition() {
                    const $tooltip = $('.tutorial-tooltip, .tutorial-tooltip-left'),
                          $target  = $('.tutorial-highlight');

                    if ($target.length && $target.is(':visible') && $tooltip.length) {
                        const step = steps[currentStep];
                        if (step) {
                            tooltipPositioning($target.offset(), step.position, $tooltip, $target);
                        }
                    }
                }

                function updateTooltipPositionWhenDemoNavOff() {
                    if ($('#mpdemo-content').is(':visible')) return;
                    const $tooltip     = $('.tutorial-tooltip');
                    const $tooltipLeft = $('.tutorial-tooltip-left');
                    const $target      = $('.tutorial-highlight');

                    if ($target.length && $target.is(':visible')) {
                        const step = steps[currentStep];
                        if (step) {
                            let offset = $target.offset();
                                offset = {
                                    top: offset.top,
                                    left: offset.left
                                };

                            if ($tooltip.length) {
                                tooltipPositioning(offset, step.position, $tooltip, $target);
                            } else if ($tooltipLeft.length) {
                                tooltipPositioning(offset, step.position, $tooltipLeft, $target);
                            }
                        }
                    }
                }

                // ==================== SCROLL FUNCTIONS ====================

                /**
                 * Scroll to top of page
                 * @param {number} duration - Animation duration in ms
                 */
                function scrollToTop(duration = 600) {
                    $('html, body').animate({scrollTop: 0}, duration);
                }

                /**
                 * Scroll to specific element
                 * @param {jQuery} target - Target element to scroll to
                 * @param {number} offset - Offset from top
                 */
                function scrollToElement(target, offset) {
                    $('html, body').animate({scrollTop: target.offset().top - offset}, 500);
                }

                // ==================== WAITING FUNCTIONS ====================

                /**
                 * Wait for element to appear in DOM
                 * @param {string} selector - CSS selector
                 * @param {Function} callback - Callback function to execute when element found
                 * @param {number} timeout - Timeout in milliseconds
                 */
                function waitForElement(selector, callback, timeout) {
                    const start = Date.now();

                    $('body').trigger('processStart');

                    const interval = setInterval(() => {
                        const $el = $(selector);

                        if ($el.length) {
                            clearInterval(interval);
                            $('body').trigger('processStop');
                            callback($el);
                        } else if (Date.now() - start > timeout) {
                            clearInterval(interval);
                            $('body').trigger('processStop');
                            console.warn('Timeout waiting for element:', selector);
                        }
                    }, 500);
                }

                /**
                 * Wait for page to become stable (no height changes)
                 * @param {Function} callback - Callback to execute when page is stable
                 * @param {number} timeout - Timeout in milliseconds
                 */
                function waitForPageStable(callback, timeout) {
                    let lastHeight  = 0,
                        stableCount = 0;
                    const requiredStableCount = 10,
                           start              = Date.now();

                    $('body').trigger('processStart');

                    const checkStability = setInterval(() => {
                        const currentHeight = document.body.scrollHeight;

                        if (currentHeight === lastHeight) {
                            stableCount++;
                        } else {
                            stableCount = 0;
                            lastHeight = currentHeight;
                        }

                        if (stableCount >= requiredStableCount) {
                            clearInterval(checkStability);
                            $('body').trigger('processStop');
                            setTimeout(callback, 200);
                        } else if (Date.now() - start > timeout) {
                            clearInterval(checkStability);
                            $('body').trigger('processStop');
                            console.warn('Page stability timeout, proceeding anyway');
                            callback();
                        }
                    }, 500);
                }

                function observeDomChanges($target) {
                    const targetNode = document.body;
                    const config = { childList: true, subtree: true };

                    let debounceTimer;
                    const observer = new MutationObserver(() => {
                        updateTooltipPosition();

                        if ($target.length) {
                            clearTimeout(debounceTimer);
                            debounceTimer = setTimeout(() => {
                                waitForPageStable(function() {
                                    if ($target.length && !isInViewport($target)) {
                                        scrollToElement($target,300);
                                    }
                                }, 2000);
                            }, 300);
                        }
                    });

                    observer.observe(targetNode, config);
                    this.domObserver = observer;
                }

                // ==================== HELPER FUNCTIONS ====================
                /**
                 * Check if current URL contains specified path
                 * @param {string} path - Path to check
                 * @returns {boolean}
                 */
                function findUrlPath(path) {
                    return window.location.pathname.includes(path);
                }

                function closeModal() {
                    const button = $('button.action-close');
                    if (button.length && button.is(':visible')) {
                        button.trigger('click');
                    }
                }

                // ==================== TRIGGER HANDLING FUNCTIONS ====================
                /**
                 * Handle step trigger actions (clicks, expansions, etc.)
                 * @param {Object} step - Step configuration
                 */
                function handleTrigger(step) {
                    const $element = $(step.element);

                    // Handle fieldset expansion triggers
                    if (step.trigger && step.trigger !== 'none' &&
                        $element.hasClass('section-config') &&
                        !$element.hasClass('active')
                    ) {
                        const isExpanded = $element.hasClass('active') || $element.hasClass('_show');
                        const $trigger = $(step.trigger);

                        if (!isExpanded) {
                            const baseUrl = window.location.origin + '/admin/admin/system_config/state/';
                            if ($trigger.length && $trigger.get(0)) {
                                Fieldset.toggleCollapse($trigger.get(0), baseUrl);
                            } else {
                                waitForElement(step.trigger, function ($resolvedTrigger) {
                                    Fieldset.toggleCollapse($resolvedTrigger.get(0), baseUrl);
                                }, 2000);
                            }
                        }
                    }
                    // Handle general click triggers
                    else if (step.trigger && step.trigger !== 'none') {
                        let $target = $(step.trigger);
                        const isExpanded = $element.hasClass('active') || $element.hasClass('_show') || $element.hasClass('open')
                        if (step.trigger === 'select#default_template') {
                            $target.select2({
                                minimumResultsForSearch: Infinity,
                                templateResult: function (data) {
                                    if (!data.id) {
                                        return data.text;
                                    }

                                    var $option = $(data.element);
                                    if ($option.hasClass('parent-category')) {
                                        return $('<span style="font-weight: bold;">' + data.text + '</span>');
                                    }

                                    return data.text;
                                }
                            });
                            $target.select2('open');
                        }
                        else if ($target.length && !isExpanded) {
                            $target.trigger('click');
                        }
                    }
                }

                /**
                 * Close all PDF invoice sections in system configuration
                 */
                function closePdfInvoiceSections() {
                    const ids = [
                        'pdfinvoice_order-head',
                        'pdfinvoice_invoice-head',
                        'pdfinvoice_shipment-head',
                        'pdfinvoice_creditmemo-head'
                    ];

                    ids.forEach(function (baseId) {
                        const $element = $('#' + baseId);

                        if ($element.length && $element.hasClass('open')) {
                            $element.trigger('click');
                        }
                    });
                }
                // ==================== STEP RENDERING FUNCTIONS ====================

                /**
                 * Apply highlighting to target element
                 * @param {jQuery} $target - Element to highlight
                 */
                function highlightTarget($target) {
                    if ($target.is('button') || $target.is('[type="button"]')) {
                        const $wrapper = $('<div class="tutorial-highlight-wrapper"></div>');
                        $target.wrap($wrapper);
                        $target.parent().addClass('tutorial-highlight');
                        addStyleToHead('<style>.tutorial-tooltip:before { left: 4% !important; }</style>');
                    } else {
                        $target.addClass('tutorial-highlight');
                        if (currentStep === 9) {
                            addStyleToHead('<style id="scale-style">' +
                                '.data-grid-actions-cell { ' +
                                    ' transform: scaleX(1.2) scaleY(1.2); ' +
                                    ' transform-origin: right; ' +
                                    ' border-radius: 6px; ' +
                                    ' overflow: hidden; ' +
                                    ' z-index:100; ' +
                                    ' filter: drop-shadow(0px 4px 4px rgba(0,0,0,0.25)); ' +
                                    '}' +
                                    '</style>');
                        }
                        if (currentStep === 12) {
                            $target.addClass('position-fixed zIndex-999');
                        }
                    }
                }

                /**
                 * Create and position tooltip
                 * @param {Object} step - Step configuration
                 * @param {number} index - Step index
                 * @param {jQuery} $target - Target element
                 */
                function createAndPositionTooltip(step, index, $target) {
                    // Create appropriate tooltip type
                    const $tooltip = step.position === 'left' ?
                        $('<div class="tutorial-tooltip-left"></div>') :
                        $('<div class="tutorial-tooltip"></div>');

                    // Set tooltip content
                    $tooltip.html(createTooltipContent(step, index));
                    $('body').append($tooltip);

                    // Position tooltip
                    const offset = $target.offset();
                    const position = step.position || 'bottom';
                    $tooltip.addClass(position);
                    if (currentStep === 9) {
                        $tooltip.addClass('tutorial-tooltip-before-right');
                    }
                    tooltipPositioning(offset, position, $tooltip, $target);
                }

                /**
                 * Render tutorial step with target element
                 * @param {jQuery} $target - Target element
                 * @param {Object} step - Step configuration
                 * @param {number} index - Step index
                 */
                function renderStep($target, step, index) {
                    // Move overlay to correct parent if needed
                    let overlay = $target.find('#tutorial-overlay');
                    if (overlay.length) {
                        $target.parent().append(overlay);
                    }

                    // Apply highlighting to target element
                    highlightTarget($target);

                    // Scroll to target element
                    if (currentStep === 17) {
                        scrollToElement($target, 600);
                    } else {
                        scrollToElement($target, 300);
                    }

                    // Create and position tooltip
                    createAndPositionTooltip(step, index, $target);

                    // Attach event handlers for this step
                    attachStepEventHandlers(step);
                }

                /**
                 * Render step when target element is not found
                 * @param {Object} step - Step configuration
                 * @param {number} index - Step index
                 */
                function renderStepWithoutTarget(step, index) {
                    const $tooltip = $('<div class="tutorial-tooltip"></div>');
                    $tooltip.html(createTooltipContent(step, index));
                    $('body').append($tooltip);

                    // Center tooltip on screen
                    centerTooltipOnScreen($tooltip);

                    // Attach event handlers
                    attachStepEventHandlers(step);
                }

                /**
                 * Handle next step button click
                 * @param {Object} step - Current step configuration
                 */
                function handleNextStep(step) {
                    if (step.trigger && step.trigger !== 'select#default_template') {
                        handleTrigger(step);
                    }

                    if (currentStep < steps.length - 1) {
                        currentStep++;
                        saveCurrentStep(currentStep);
                        showStep(currentStep);
                        if ([4].includes(currentStep)) {
                            closePdfInvoiceSections();
                        }
                        if (currentStep === 10) {
                            removeStyleOnHead('scale-style');
                        }

                        if (currentStep !== 12) {
                            closeModal();
                        }

                        if (currentStep === 17) {
                            resetTemplateNote();
                            resetSelect2Css();
                        }
                    } else {
                        // Tutorial completed - show end screen
                        cleanupTutorialUI();
                        $('#tutorial-end-box').fadeIn();
                    }
                }

                /**
                 * Handle previous step button click
                 * @param {Object} step - Current step configuration
                 */
                function handlePreviousStep(step) {
                    if (step.trigger && step.trigger !== 'select#default_template') {
                        handleTrigger(step);
                    }

                    if (currentStep > 0) {
                        currentStep--;
                        saveCurrentStep(currentStep);
                        showStep(currentStep);
                        if ([4].includes(currentStep)) {
                            closePdfInvoiceSections();
                        }
                        if (currentStep === 10) {
                            removeStyleOnHead('scale-style');
                        }

                        if (currentStep !== 12) {
                            closeModal();
                        }

                        if (currentStep === 15) {
                            resetTemplateNote();
                            resetSelect2Css();
                        }

                        if (currentStep === 16) {
                            moveTemplateNote();
                            changeSelect2Css();
                        }
                    }
                }

                /**
                 * Attach event handlers for current step
                 * @param {Object} step - Step configuration
                 */
                function attachStepEventHandlers(step) {
                    // Next step handler
                    $('#next-step').off('click').on('click', () => handleNextStep(step));

                    // Previous step handler
                    $('#prev-step').off('click').on('click', () => handlePreviousStep(step));

                    // Skip tutorial handler
                    $('.skip-tutorial').off('click').on('click', closeTutorial);
                }


                /**
                 * Go back to last step from end screen
                 */
                function goBackToLastStep() {
                    currentStep = steps.length - 1;
                    $('#tutorial-end-box').fadeOut(function () {
                        showStep(currentStep);
                    });
                }

                // ==================== MAIN TUTORIAL FUNCTIONS ====================

                /**
                 * Close and cleanup tutorial completely
                 */
                function closeTutorial() {
                    markTutorialAsSkipped();
                    cleanupTutorialUI();
                    skipTutorial();
                    removeStyleOnHead('scale-style');
                    closeModal();
                    if (currentStep === 16) {
                        resetTemplateNote();
                        resetSelect2Css();
                    }
                }

                /**
                 * Show specific tutorial step
                 * @param {number} index - Step index to show
                 */
                function showStep(index) {
                    if (index < 0 || index >= steps.length) return;

                    const step = steps[index];

                    // Check if we need to navigate to different page
                    if (window.location.pathname !== step.url) {
                        saveCurrentStep(index);
                        window.location.href = step.url;
                        return;
                    }

                    // Handle step trigger if present
                    if (step.trigger) {
                        handleTrigger(step);
                    }

                    // Clean up previous step UI
                    $('.tutorial-highlight').removeClass('tutorial-highlight');
                    $('.tutorial-tooltip, .tutorial-tooltip-left').remove();

                    if (currentStep === 16) {
                        moveTemplateNote();
                        changeSelect2Css();
                    }

                    // Find target element
                    const $target = $(step.element);

                    if ($target.length && currentStep !== 10) {
                        // Target element found - render normally
                        renderStep($target, step, index);
                    } else if (!$target.length || currentStep === 10) {
                        let timeout = 2000;
                        // Target element not found - wait for it
                        if (currentStep === 12) {
                            timeout = 10000;
                        }
                        if (currentStep === 10) {
                            timeout = 1000;
                        }
                        waitForElement(step.element, function ($foundTarget) {
                            waitForPageStable(function() {
                                if ($foundTarget.length) {
                                    renderStep($foundTarget, step, index);
                                }
                            }, timeout);
                        }, timeout);
                    } else {
                        renderStepWithoutTarget(step, index);
                    }
                }

                /**
                 * Start tutorial from beginning
                 */
                function startTutorial() {
                    currentStep = 0;
                    saveCurrentStep(currentStep);
                    $('#tutorial-first-box').fadeOut(function () {
                        showStep(currentStep);
                    });
                }

                /**
                 * Resume tutorial from saved step or show initial popup
                 */
                function initializeTutorial() {
                    if (isSkipped()) return;

                    const savedStep = getSavedStep();

                    if (savedStep !== null) {
                        // Resume from saved step
                        currentStep = savedStep;
                        $('#tutorial-overlay, #popup-container').show();
                        showStep(currentStep);
                    } else {
                        // Show initial popup
                        showFirstPopup();
                        $('.skip-tutorial').off('click').on('click', closeTutorial);
                    }
                }

                // ==================== EVENT LISTENERS SETUP ====================

                /**
                 * Set up all global event listeners
                 */
                function setupEventListeners() {
                    // Start tutorial button
                    $('#start-tutorial').off('click').on('click', startTutorial);

                    // Go back to last step from end screen
                    $('#prev-last-step').off('click').on('click', goBackToLastStep);

                    // Window resize and scroll handlers
                    $(window).off('resize.tutorial scroll.tutorial')
                        .on('resize.tutorial scroll.tutorial', updateTooltipPosition);

                    // Navigation and popup handlers
                    $(document).on('click', 'button.navigation-close', function () {
                        updateTooltipPositionWhenDemoNavOff();
                    });
                    $(document).on('click', '#show-popup-btn', function () {
                        updateTooltipPosition();
                    });
                }

                // ==================== INITIALIZATION ====================

                /**
                 * Initialize the tutorial system
                 */
                function init() {
                    // Set up event listeners
                    setupEventListeners();

                    // Start tutorial initialization with slight delay
                    setTimeout(function () {
                        initializeTutorial();
                    }, 0);
                }

                // Start the tutorial system
                init();
            });
        });
    </script>

